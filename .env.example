# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- The ONLY line you change to switch provider/model ---
LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
# LLM_MODEL=openai/gpt-4o
# LLM_MODEL=gemini/gemini-2.0-flash
# LLM_MODEL=ollama/llama3                 # + set LLM_BASE_URL below
# LLM_MODEL=openhands/claude-sonnet-4-5-20250929   # OpenHands proxy
# NOTE: model ID strings change over time — verify current IDs against the
# provider + LiteLLM docs if one errors.

# Key for whichever provider LLM_MODEL selects.
LLM_API_KEY=
# Only for local/self-hosted models (e.g. http://localhost:11434). Leave blank otherwise.
# NOTE: python-dotenv does not strip a trailing "# comment" from a line whose
# value is otherwise blank — keep this line's value empty with no trailing text.
LLM_BASE_URL=

# Provider-neutral reasoning effort, passed straight through to the SDK
# (LiteLLM translates it per-provider). Leave blank to use the SDK's own
# default ("high"). Common values: none | minimal | low | medium | high |
# xhigh | max — the SDK also accepts future provider-specific values.
LLM_REASONING_EFFORT=

# --- Harness policy (ours, not the LLM's) ---
HARNESS_WORKSPACE=.                       # working dir the agent operates in (ignored if --project is used)
HARNESS_MAX_ITERATIONS=50                 # safety cap on the agent loop
HARNESS_CONFIRM_MODE=never                # never | always (pause before each tool call)
HARNESS_EXECUTION=local                   # local | docker

# --- Projects: one subfolder per generated project (see MANUAL.md) ---
HARNESS_PROJECTS_DIR=./projects           # root folder; --project NAME -> HARNESS_PROJECTS_DIR/NAME

# --- Shared skill catalog, loaded into every agent (see MANUAL.md "Skills") ---
HARNESS_SKILLS_DIR=./skills

# --- Only consulted when HARNESS_EXECUTION=docker ---
HARNESS_DOCKER_IMAGE=coding-agent-harness/agent-server:local  # built automatically on first use
HARNESS_DOCKER_PLATFORM=                  # linux/amd64 | linux/arm64; blank = auto-detect from host

# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- The ONLY line you change to switch provider/model ---
LLM_MODEL=anthropic/claude-sonnet-4-5-20250929
# LLM_MODEL=openai/gpt-4o
# LLM_MODEL=gemini/gemini-2.0-flash
# LLM_MODEL=ollama/llama3                 # + set LLM_BASE_URL below
# LLM_MODEL=openhands/claude-sonnet-4-5-20250929   # OpenHands proxy
# NOTE: model ID strings change over time — verify current IDs against the
# provider + LiteLLM docs if one errors.

# Key for whichever provider LLM_MODEL selects.
LLM_API_KEY=
# Only for local/self-hosted models (e.g. http://localhost:11434). Leave blank otherwise.
# NOTE: python-dotenv does not strip a trailing "# comment" from a line whose
# value is otherwise blank — keep this line's value empty with no trailing text.
LLM_BASE_URL=

# Provider-neutral reasoning effort, passed straight through to the SDK
# (LiteLLM translates it per-provider). Leave blank to use the SDK's own
# default ("high"). Common values: none | minimal | low | medium | high |
# xhigh | max — the SDK also accepts future provider-specific values.
LLM_REASONING_EFFORT=

# --- Harness policy (ours, not the LLM's) ---
HARNESS_WORKSPACE=.                       # working dir the agent operates in (ignored if --project is used)
HARNESS_MAX_ITERATIONS=50                 # safety cap on the agent loop
HARNESS_CONFIRM_MODE=never                # never | always (pause before each tool call)
HARNESS_EXECUTION=local                   # local | docker

# --- Projects: one subfolder per generated project (see MANUAL.md) ---
HARNESS_PROJECTS_DIR=./projects           # root folder; --project NAME -> HARNESS_PROJECTS_DIR/NAME

# --- Shared skill catalog, loaded into every agent (see MANUAL.md "Skills") ---
HARNESS_SKILLS_DIR=./skills

# --- Post-hoc test verification (see MANUAL.md "Test verification") ---
# After the agent finishes, the harness itself re-runs the project's own
# checks (no LLM involved) rather than trusting the agent's self-report.
HARNESS_VERIFY_TESTS=always               # always | never
HARNESS_MAX_VERIFY_RETRIES=2              # how many fix-and-recheck cycles before giving up

# --- Shared, task-level wall-clock budget (see MANUAL.md) ---
# Spans the whole task — the initial run plus every verify/retry cycle —
# not just one SDK conversation.run() call.
HARNESS_MAX_TASK_SECONDS=1800

# Opt-in: allow the agent to pause and ask a question instead of always
# pushing forward autonomously (only the CLI's --interactive prompts a real
# human at the terminal; setting this without a caller that answers has no
# useful effect — see MANUAL.md "Interactive mode").
HARNESS_INTERACTIVE=no

# --- Only consulted when HARNESS_EXECUTION=docker ---
HARNESS_DOCKER_IMAGE=coding-agent-harness/agent-server:local  # built automatically on first use
HARNESS_DOCKER_PLATFORM=                  # linux/amd64 | linux/arm64; blank = auto-detect from host

# --- Server-mode task registry persistence (see MANUAL.md "Task registry
# persistence"). Only consulted by `harness-server`/`harness-admin`, not the
# `harness` CLI. Default ("memory", TTL=0) is byte-for-byte the pre-existing
# in-memory, unbounded, per-process behavior — every setting below is opt-in.
HARNESS_TASK_STORE=memory                 # memory | redis | sqlite | mysql | postgres
HARNESS_TASK_TTL_SECONDS=0                # seconds a completed/failed task record is kept; 0 = forever

# sqlite (needs the "store-sqlite" extra: uv pip install -e ".[store-sqlite]")
HARNESS_TASK_STORE_SQLITE_PATH=./harness_tasks.db

# mysql (needs "store-mysql": uv pip install -e ".[store-mysql]")
HARNESS_TASK_STORE_MYSQL_HOST=localhost
HARNESS_TASK_STORE_MYSQL_PORT=3306
HARNESS_TASK_STORE_MYSQL_USER=root
HARNESS_TASK_STORE_MYSQL_PASSWORD=
HARNESS_TASK_STORE_MYSQL_DATABASE=harness

# postgres (needs "store-postgres": uv pip install -e ".[store-postgres]")
HARNESS_TASK_STORE_POSTGRES_HOST=localhost
HARNESS_TASK_STORE_POSTGRES_PORT=5432
HARNESS_TASK_STORE_POSTGRES_USER=postgres
HARNESS_TASK_STORE_POSTGRES_PASSWORD=
HARNESS_TASK_STORE_POSTGRES_DATABASE=harness

# redis (needs "store-redis": uv pip install -e ".[store-redis]") — uses
# Redis's own native per-key expiration for the TTL above, not a purge sweep.
HARNESS_TASK_STORE_REDIS_HOST=localhost
HARNESS_TASK_STORE_REDIS_PORT=6379
HARNESS_TASK_STORE_REDIS_DB=0
HARNESS_TASK_STORE_REDIS_PASSWORD=
HARNESS_TASK_STORE_REDIS_USE_TLS=false
